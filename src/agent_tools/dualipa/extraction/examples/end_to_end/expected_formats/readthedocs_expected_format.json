      "content": "{'headers': ['Column 1', 'Column 2'], 'rows': [['Value 1', 'Value 2'], ['Value 3', 'Value 4']]}",
      "file_path": "/path/to/downloaded/readthedocs/index.html",
      "parent_uuid": "section-uuid-placeholder",
      "metadata": {
        "headers": [
          "Column 1",
          "Column 2"
        ],
        "rows": [
          [
            "Value 1",
