{
  "description": "Expected format for HTML documentation extraction validation",
  "version": "1.0",
  "expected_structure": {
    "required_block_types": [
      "documentation",
      "doc_page",
      "doc_section",
      "code_block",
      "table",
      "image"
    ],
    "hierarchy": [
      {
        "parent_type": "documentation",
        "child_types": ["doc_page"]
      },
      {
        "parent_type": "doc_page",
        "child_types": ["doc_section"]
      },
      {
        "parent_type": "doc_section",
        "child_types": ["doc_section", "code_block", "table", "image"]
      }
    ],
    "metadata_checks": [
      {
        "field": "uuid",
        "requirement": "uuid_format"
      },
      {
        "field": "metadata.language",
        "requirement": "not_empty"
      },
      {
        "field": "metadata.source_url",
        "requirement": "not_empty"
      },
      {
        "field": "type",
        "requirement": "one_of:documentation,doc_page,doc_section,code_block,table,image"
      },
      {
        "field": "metadata.doc_type",
        "requirement": "one_of:readthedocs,arangodb,test"
      }
    ],
    "validation_threshold": 80
  },
  "structure_consistency": {
    "required_root_blocks": ["documentation"],
    "hierarchical_types": [
      {
        "parent": "documentation",
        "children": ["doc_page"]
      },
      {
        "parent": "doc_page",
        "children": ["doc_section"]
      },
      {
        "parent": "doc_section",
        "children": ["doc_section", "code_block", "table", "image"]
      }
    ],
    "bidirectional_references": true,
    "no_circular_references": true,
    "validation_threshold": 90
  },
  "html_specific_validation": {
    "section_hierarchy": {
      "level_order": true,
      "section_hierarchy_metadata": true
    },
    "special_elements": {
      "code_language_detection": true,
      "table_extraction": true,
      "image_attributes": true
    },
    "html_content": {
      "clean_html": true,
      "preserve_structure": true
    },
    "validation_threshold": 85
  }
}